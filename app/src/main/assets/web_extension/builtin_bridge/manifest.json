{
  "manifest_version": 2,
  "name": "Evo Bridge",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "evo-bridge-v3@dev1503.browseevo"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "resource://android/assets/built-in_page/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
