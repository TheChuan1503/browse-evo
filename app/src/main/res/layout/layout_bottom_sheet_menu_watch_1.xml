<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="夜间模式"
            android:id="@+id/btnDarkMode"
            android:enabled="false"
            app:icon="@drawable/moon_stars_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="书签"
            android:id="@+id/btnBookmarks"
            app:icon="@drawable/star_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="历史"
            android:id="@+id/btnHistory"
            app:icon="@drawable/history_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="下载"
            android:id="@+id/btnDownloads"
            app:icon="@drawable/download_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="分享"
            android:id="@+id/btnShare"
            app:icon="@drawable/share_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="添加书签"
            android:id="@+id/btnAddBookmark"
            app:icon="@drawable/bookmark_add_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="工具箱"
            android:id="@+id/btnTools"
            app:icon="@drawable/handyman_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:text="设置"
            android:id="@+id/btnSettings"
            app:icon="@drawable/settings_24px"
            app:iconGravity="top"
            style="@style/Widget.Material3.Button.IconButton" />
    </LinearLayout>
</LinearLayout>
