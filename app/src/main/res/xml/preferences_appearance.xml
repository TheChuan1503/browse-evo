<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <DropDownPreference
        android:key="device_type"
        android:title="布局类型"
        android:icon="@drawable/responsive_layout_24px"
        android:entries="@array/device_types"
        android:entryValues="@array/device_type_values"
        app:useSimpleSummaryProvider="true"/>
    <DropDownPreference
        android:key="appearance/dark_mode"
        android:title="夜间模式"
        android:icon="@drawable/moon_stars_24px"
        android:entries="@array/dark_mode_entries"
        android:entryValues="@array/dark_mode_entry_values"
        app:useSimpleSummaryProvider="true"/>
</androidx.preference.PreferenceScreen>